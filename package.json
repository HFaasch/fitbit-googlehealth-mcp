{
  "name": "google-health-mcp",
  "version": "0.1.0",
  "description": "MCP server for the Google Health API (sleep data), deployed as a remote OAuth-protected Cloudflare Worker usable from Claude and ChatGPT.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@hono/mcp": "^0.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "hono": "^4.7.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@cloudflare/workers-types": "^5",
    "@types/node": "^22",
    "typescript": "^5.7",
    "wrangler": "^4"
  }
}
